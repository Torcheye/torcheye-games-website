---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { SITE } from "@consts";
import { getLocaleFromUrl, useTranslations, addLocalePrefix } from "@i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Layout title={t.notFound.title} description={SITE.DESCRIPTION}>
  <Container>
    <div class="mt-16 grid place-items-center gap-3">
      <h4 class="animate text-2xl font-semibold text-black dark:text-white">
        {t.notFound.title}
      </h4>
      <span class="animate">
        <BackToPrevious href={addLocalePrefix("/", locale)}>{t.notFound.goHome}</BackToPrevious>
      </span>
    </div>
  </Container>
</Layout>
