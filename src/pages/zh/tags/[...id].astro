---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { getLocaleFromUrl, useTranslations, addLocalePrefix } from "@i18n/utils";
import type { BlogEntry } from "@/types/blog";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")) as BlogEntry[];
  const filtered = posts.filter((post) => !post.data.draft && post.data.locale === "zh");

  const tags = [...new Set(filtered.flatMap((post) => post.data.tags || []))];

  return tags.map((tag) => ({
    params: { id: tag },
    props: {
      posts: filtered.filter((post) => post.data.tags?.includes(tag)),
    },
  }));
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const tag = Astro.params.id ?? "";
const { posts } = Astro.props as { posts: BlogEntry[] };

const sortedPosts = posts
  .filter((post) => post.data.locale === locale)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title={t.tags.taggedWith(tag)} description={t.meta.blogDescription}>
  <Container>
    <div class="space-y-10" data-pagefind-ignore>
      <BackToPrevious href={addLocalePrefix("/tags", locale)}>{t.tags.allTags}</BackToPrevious>
      <h1 class="animate font-semibold text-black dark:text-white">
        {t.tags.taggedWith(tag)}
      </h1>
      <ul class="animate flex flex-col gap-4">
        {sortedPosts.map((post) => <ArrowCard entry={post} />)}
      </ul>
    </div>
  </Container>
</Layout>
