---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { HOME, SITE, SOCIALS } from "@consts";
import { getCollection, type CollectionEntry } from "astro:content";
import { readdir } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import { extname } from "node:path";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const screenshotDir = fileURLToPath(
  new URL("../../public/images/screenshots", import.meta.url),
);
let screenshots: { src: string; alt: string }[] = [];
try {
  const files = await readdir(screenshotDir);
  const supported = [".png", ".jpg", ".jpeg", ".gif", ".webp"];
  screenshots = files
    .filter((file) => supported.includes(extname(file).toLowerCase()))
    .sort((a, b) => {
      const numA = parseInt(a.match(/\d+/)?.[0] ?? "0", 10);
      const numB = parseInt(b.match(/\d+/)?.[0] ?? "0", 10);
      return numA - numB;
    })
    .map((file, index) => ({
      src: `/images/screenshots/${file}`,
      alt: `Gameplay screenshot ${index + 1}`,
    }));
} catch (error) {
  screenshots = [];
}

const features = [
  {
    title: "Embrace Shadows",
    description:
      "Slip into murky spaces where silhouettes harden into platforms and the unknown can be shaped like clay.",
  },
  {
    title: "Manipulate Light",
    description:
      "Bend spotlights, beams, and reflections to carve pathways, disarm threats, and reveal hidden rooms.",
  },
  {
    title: "Explore Dreams",
    description:
      "Uncover a surreal mystery told through atmospheric vignettes and environmental storytelling.",
  },
];
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16" data-pagefind-ignore>
      <section class="animate grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="space-y-6">
          <p class="text-sm uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-400">
            Torcheye Games presents
          </p>
          <div class="space-y-4">
            <h1 class="text-4xl font-semibold text-black dark:text-white md:text-5xl">
              Chiaroscuro
            </h1>
            <p class="text-lg text-black/70 dark:text-white/70">
              A surreal puzzle-platformer where light and shadow are more than visual effects —
              they are the rules of reality.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://store.steampowered.com/app/2831270"
              class="rounded-sm border border-black/15 bg-black px-4 py-2 text-sm font-semibold text-white transition hover:opacity-80 focus-visible:opacity-80 dark:border-white/20"
            >
              Wishlist on Steam
            </a>
            <a
              href="/works"
              class="rounded-sm border border-black/15 px-4 py-2 text-sm font-semibold transition hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
            >
              Explore the works
            </a>
          </div>
          <p class="text-sm uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-400">
            Coming soon – add to your wishlist to follow development.
          </p>
        </div>
        <div class="animate rounded-2xl border border-black/15 bg-neutral-900/70 p-3 shadow-2xl shadow-black/40 dark:border-white/10">
          <div class="aspect-video overflow-hidden rounded-xl">
            <iframe
              src="https://www.youtube.com/embed/d-wI4MjySb8?rel=0&modestbranding=1"
              title="Chiaroscuro trailer"
              loading="lazy"
              class="size-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section class="space-y-6">
        <div class="animate flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-sm uppercase tracking-[0.3em] text-neutral-500 dark:text-neutral-400">
              Key ideas
            </p>
            <h2 class="text-2xl font-semibold text-black dark:text-white">Light as a design tool</h2>
          </div>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {features.map((feature) => (
            <article class="animate rounded-xl border border-black/15 bg-white/70 p-4 text-left transition hover:-translate-y-1 hover:border-black/30 dark:border-white/20 dark:bg-white/5">
              <h3 class="text-xl font-semibold text-black dark:text-white">{feature.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-black/70 dark:text-white/70">
                {feature.description}
              </p>
            </article>
          ))}
        </div>
      </section>

      <section class="space-y-6">
        <div class="animate flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-2xl font-semibold text-black dark:text-white">Latest posts</h2>
          <Link href="/blog">View all</Link>
        </div>
        {blog.length === 0 ? (
          <div class="animate rounded-xl border border-dashed border-black/15 p-6 text-sm leading-relaxed text-black/70 dark:border-white/20 dark:text-white/70">
            <p class="font-semibold text-black dark:text-white">Dev blog launching soon</p>
            <p>
              Expect deep dives into game design, art direction, programming breakdowns, and studio updates once
              entries begin rolling out.
            </p>
          </div>
        ) : (
          <ul class="not-prose flex flex-col gap-4">
            {blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="space-y-6">
        <div class="animate flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-2xl font-semibold text-black dark:text-white">Recent works</h2>
          <Link href="/works">Browse all</Link>
        </div>
        {projects.length === 0 ? (
          <div class="animate rounded-xl border border-dashed border-black/15 p-6 text-sm leading-relaxed text-black/70 dark:border-white/20 dark:text-white/70">
            <p class="font-semibold text-black dark:text-white">More games on the way</p>
            <p>
              We're prototyping additional experiences that explore contrast, tension, and atmosphere.
            </p>
          </div>
        ) : (
          <ul class="not-prose flex flex-col gap-4">
            {projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        )}
      </section>

      {screenshots.length > 0 && (
        <section class="space-y-6">
          <div class="animate flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-2xl font-semibold text-black dark:text-white">Mood board</h2>
            <p class="text-sm text-black/60 dark:text-white/60">
              Captured straight from the current Chiaroscuro build.
            </p>
          </div>
          <div class="animate grid gap-4 md:grid-cols-3">
            {screenshots.map((shot) => (
              <figure class="overflow-hidden rounded-xl border border-black/15 dark:border-white/10">
                <img src={shot.src} alt={shot.alt} loading="lazy" class="h-full w-full object-cover" />
              </figure>
            ))}
          </div>
        </section>
      )}

      <section class="space-y-6">
        <div class="animate rounded-2xl border border-black/15 bg-black px-6 py-8 text-white dark:border-white/10">
          <h2 class="text-3xl font-semibold">Join the journey</h2>
          <p class="mt-4 text-base text-white/80">
            Chiaroscuro explores the blurred space between illumination and darkness. Help shape it by wishlisting,
            sharing feedback, or simply following along as we document the process.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="https://store.steampowered.com/app/2831270"
              class="rounded-sm border border-white/40 bg-white px-4 py-2 text-sm font-semibold text-black transition hover:opacity-90"
            >
              Wishlist on Steam
            </a>
            <a
              href="https://discord.gg/RHggGYAQjp"
              class="rounded-sm border border-white/40 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              Join the Discord
            </a>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="animate text-2xl font-semibold text-black dark:text-white">Connect</h2>
        <ul class="animate flex flex-wrap gap-3 text-sm">
          {SOCIALS.map((social) => (
            <li>
              <Link href={social.HREF} external>{social.NAME}</Link>
            </li>
          ))}
          <li class="text-black/70 dark:text-white/70">
            <Link href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</Layout>
