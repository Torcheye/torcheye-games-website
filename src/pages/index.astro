---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import MediaGallery from '../components/MediaGallery.astro';
import WishlistButton from '../components/WishlistButton.astro';
import { readdir } from 'node:fs/promises';
import { join } from 'node:path';

// Dynamically load all screenshot images from the public/images/screenshots directory
const screenshotsDir = join(process.cwd(), 'public', 'images', 'screenshots');
const screenshotFiles = await readdir(screenshotsDir);

// Filter for image files and sort them naturally by filename
const imageExtensions = ['.webp', '.png', '.jpg', '.jpeg', '.gif'];
const screenshots = screenshotFiles
	.filter(file => imageExtensions.some(ext => file.toLowerCase().endsWith(ext)))
	.sort((a, b) => {
		// Extract numbers from filenames for natural sorting (e.g., screenshot_1, screenshot_2, etc.)
		const numA = parseInt(a.match(/\d+/)?.[0] || '0');
		const numB = parseInt(b.match(/\d+/)?.[0] || '0');
		return numA - numB;
	})
	.map((filename, index) => ({
		id: index + 1,
		url: `/images/screenshots/${filename}`,
		alt: `Gameplay Screenshot ${index + 1}`
	}));
---

<Layout
	title="Chiaroscuro - A Game of Light and Shadow"
	description="Navigate a world where light and shadow shape reality. Manipulate contrasts to solve puzzles and uncover mysteries in Chiaroscuro."
	showHeader={true}
	showFooter={true}
>
	<main>
		<!-- Hero Section with Video -->
		<HeroSection
			videoId="d-wI4MjySb8"
			title="Chiaroscuro"
			tagline="A Game of Light and Shadow"
			releaseYear="TBD"
			steamUrl="https://store.steampowered.com/app/2831270"
		/>

		<!-- Features Showcase -->
		<FeatureShowcase
			features={[
				{
					title: "Embrace Shadows",
					description: "Utilize shadows for exploration and survival",
					coverImage: "/cover-image.png",
					gifUrl: "/images/features/Light Object Demo.gif",
					align: "left"
				},
				{
					title: "Manipulate Light",
					description: "Control light to solve puzzles and shape reality",
					coverImage: "/cover-image.png",
					gifUrl: "/images/features/Vine Demo.gif",
					align: "right"
				},
				{
					title: "Explore Dreams",
					description: "Unravel mysteries in a surreal, dreamlike world",
					coverImage: "/cover-image.png",
					gifUrl: "/images/features/Player Shadow Dimension.gif",
					align: "left"
				}
			]}
		/>

		<!-- Media Gallery -->
		<MediaGallery
			showHeading={false}
			autoPlayInterval={3000}
			images={screenshots}
		/>

		<!-- Final CTA Section -->
		<section class="final-cta">
			<div class="cta-content">
				<h2 class="cta-heading">Join the Journey</h2>
				<p class="cta-description">
					In Chiaroscuro, navigate a world where light and shadow are not just visual elements,
					but the very fabric of reality. Manipulate contrasts to solve puzzles, reveal hidden paths,
					and uncover the mysteries of a realm caught between illumination and darkness.
				</p>
				<WishlistButton steamUrl="https://store.steampowered.com/app/2831270" size="large" />
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(html) {
		background: #1e1c32;
		color: #c6baac;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		padding: 0;
		font-family: 'IM Fell English', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		line-height: 1.6;
		overflow-x: hidden;
	}

	main {
		width: 100%;
		margin: 0;
		padding: 0;
	}

	/* Final CTA Section */
	.final-cta {
		background-color: #1e1c32;
		padding: 6rem 2rem;
		text-align: center;
	}

	.cta-content {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.cta-heading {
		font-family: 'IM Fell English', serif;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		color: var(--color-text-primary, #c6baac);
		margin: 0;
		letter-spacing: -0.02em;
	}

	.cta-description {
		font-size: 1.25rem;
		line-height: 1.8;
		color: var(--color-text-secondary, #b4b4b4);
		margin: 0;
		max-width: 700px;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.final-cta {
			padding: 4rem 1.5rem;
		}

		.cta-content {
			gap: 1.5rem;
		}

		.cta-description {
			font-size: 1.125rem;
		}
	}

	@media (max-width: 480px) {
		.final-cta {
			padding: 3rem 1rem;
		}
	}
</style>