---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import MediaGallery from '../components/MediaGallery.astro';
---

<Layout
	title="Chiaroscuro - A Game of Light and Shadow"
	description="Navigate a world where light and shadow shape reality. Manipulate contrasts to solve puzzles and uncover mysteries in Chiaroscuro."
	showHeader={true}
	showFooter={true}
>
	<main>
		<!-- Hero Section with Video -->
		<HeroSection
			videoId="d-wI4MjySb8"
			title="Chiaroscuro"
			tagline="A Game of Light and Shadow"
			releaseYear="2026"
			steamUrl="https://store.steampowered.com/app/2831270"
		/>

		<!-- Features Showcase -->
		<FeatureShowcase
			features={[
				{
					title: "Embrace Shadows",
					description: "Navigate through darkness and discover hidden paths where light cannot reach.",
					coverImage: "/cover-image.png",
					gifUrl: "/cover-image.png",
					align: "left"
				},
				{
					title: "Manipulate Light",
					description: "Control light sources to solve intricate puzzles and reveal the truth.",
					coverImage: "/cover-image.png",
					gifUrl: "/cover-image.png",
					align: "right"
				},
				{
					title: "Explore Contrasts",
					description: "Experience a world where the boundary between light and shadow shapes reality itself.",
					coverImage: "/cover-image.png",
					gifUrl: "/cover-image.png",
					align: "left"
				}
			]}
		/>

		<!-- Media Gallery -->
		<MediaGallery
			showHeading={false}
			autoPlayInterval={3000}
			images={[
				{ id: 1, url: "/cover-image.png", alt: "Chiaroscuro gameplay 1" },
				{ id: 2, url: "/cover-image.png", alt: "Chiaroscuro gameplay 2" },
				{ id: 3, url: "/cover-image.png", alt: "Chiaroscuro gameplay 3" },
				{ id: 4, url: "/cover-image.png", alt: "Chiaroscuro gameplay 4" },
				{ id: 5, url: "/cover-image.png", alt: "Chiaroscuro gameplay 5" },
				{ id: 6, url: "/cover-image.png", alt: "Chiaroscuro gameplay 6" }
			]}
		/>

		<!-- Final CTA Section -->
		<section class="final-cta">
			<div class="cta-content">
				<h2 class="cta-heading">Join the Journey</h2>
				<p class="cta-description">
					In Chiaroscuro, navigate a world where light and shadow are not just visual elements,
					but the very fabric of reality. Manipulate contrasts to solve puzzles, reveal hidden paths,
					and uncover the mysteries of a realm caught between illumination and darkness.
				</p>
				<a href="https://store.steampowered.com/app/2831270" class="cta-button" target="_blank" rel="noopener">
					<svg class="cta-icon" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5l7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z" />
					</svg>
					Wishlist on Steam
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(html) {
		background: #1e1c32;
		color: #c6baac;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		padding: 0;
		font-family: 'IM Fell English', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		line-height: 1.6;
		overflow-x: hidden;
	}

	main {
		width: 100%;
		margin: 0;
		padding: 0;
	}

	/* Final CTA Section */
	.final-cta {
		background-color: #1e1c32;
		padding: 6rem 2rem;
		text-align: center;
	}

	.cta-content {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.cta-heading {
		font-family: 'IM Fell English', serif;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		color: var(--color-text-primary, #c6baac);
		margin: 0;
		letter-spacing: -0.02em;
	}

	.cta-description {
		font-size: 1.25rem;
		line-height: 1.8;
		color: var(--color-text-secondary, #b4b4b4);
		margin: 0;
		max-width: 700px;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1.5rem 3rem;
		background: linear-gradient(135deg, #1b2838 0%, #2a475e 100%);
		color: var(--color-text-primary, #c6baac);
		border: 2px solid var(--color-border-light, #c6baac);
		text-decoration: none;
		font-size: 1.25rem;
		font-weight: 600;
		transition: all 0.3s ease;
		margin-top: 1rem;
	}

	.cta-button:hover {
		background: linear-gradient(135deg, #2a475e 0%, #1b2838 100%);
		transform: scale(1.05);
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
	}

	.cta-icon {
		width: 1.75rem;
		height: 1.75rem;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.final-cta {
			padding: 4rem 1.5rem;
		}

		.cta-content {
			gap: 1.5rem;
		}

		.cta-description {
			font-size: 1.125rem;
		}

		.cta-button {
			padding: 1.25rem 2rem;
			font-size: 1.125rem;
		}

		.cta-icon {
			width: 1.5rem;
			height: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		.final-cta {
			padding: 3rem 1rem;
		}

		.cta-button {
			padding: 1rem 1.5rem;
			font-size: 1rem;
		}
	}
</style>