---
/**
 * Blog Index Page
 * Lists all blog posts with previews
 */

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Get all blog posts, sorted by date (newest first)
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Get unique tags from all posts
const allTags = [...new Set(posts.flatMap(post => post.data.tags))].sort();

// Format date helper
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};
---

<Layout
  title="Blog - Torcheye Games"
  description="Development insights, design breakdowns, and updates from Torcheye Games - an indie game studio."
>
  <div class="blog-page">
    <div class="container">
      <!-- Hero Section -->
      <section class="blog-hero">
        <h1 class="page-title">Dev Blog</h1>
        <p class="page-subtitle">
          Development insights, technical breakdowns, and studio updates
        </p>
      </section>

      <!-- Tag Filter -->
      {allTags.length > 0 && (
        <section class="tag-filter">
          <h2 class="filter-title">Filter by tag:</h2>
          <div class="tag-list">
            {allTags.map(tag => (
              <a
                href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                class="tag-link"
              >
                {tag}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Blog Posts -->
      <section class="posts-section">
        {posts.length === 0 ? (
          <div class="coming-soon">
            <div class="coming-soon-content">
              <h2 class="coming-soon-title">Coming Soon</h2>
              <div class="coming-soon-divider"></div>
              <p class="coming-soon-text">
                Our dev blog is launching soon. Stay tuned for insights into our game development process,
                technical breakdowns, art discussions, and studio updates.
              </p>
              <div class="coming-soon-topics">
                <span class="topic">Game Design</span>
                <span class="topic">Art & Tech Art</span>
                <span class="topic">Programming</span>
                <span class="topic">Devlogs</span>
              </div>
            </div>
          </div>
        ) : (
          <div class="posts-grid">
            {posts.map(post => (
              <article class="post-card">
                {post.data.coverImage && (
                  <a href={`/blog/${post.id}`} class="post-image-link">
                    <div class="post-image">
                      <img
                        src={post.data.coverImage}
                        alt={`Cover for ${post.data.title}`}
                        loading="lazy"
                      />
                    </div>
                  </a>
                )}

                <div class="post-content">
                  <div class="post-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    {post.data.author && (
                      <>
                        <span class="meta-separator">•</span>
                        <span class="post-author">{post.data.author}</span>
                      </>
                    )}
                  </div>

                  <h2 class="post-title">
                    <a href={`/blog/${post.id}`}>
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="post-excerpt">{post.data.excerpt}</p>

                  {post.data.tags.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags.map(tag => (
                        <a
                          href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                          class="tag"
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  )}

                  <a href={`/blog/${post.id}`} class="read-more">
                    Read More →
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</Layout>

<style>
  .blog-page {
    padding: var(--space-16) 0;
  }

  /* Hero */
  .blog-hero {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    margin-bottom: var(--space-4);
  }

  .page-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-tertiary);
    max-width: 700px;
    margin: 0 auto;
  }

  /* Tag Filter */
  .tag-filter {
    margin-bottom: var(--space-12);
    padding: var(--space-6);
    background: var(--color-bg-secondary);
    border: var(--border-medium) solid var(--color-border);
  }

  .filter-title {
    font-size: var(--text-base);
    font-family: var(--font-body);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-link {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: var(--border-medium) solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-tertiary);
    transition: all var(--transition-base);
  }

  .tag-link:hover {
    border-color: var(--color-border-light);
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  /* Posts Section */
  .posts-section {
    margin-bottom: var(--space-16);
  }

  /* Coming Soon Section */
  .coming-soon {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 400px;
    padding: var(--space-12);
    background: var(--color-bg-secondary);
    border: var(--border-thick) solid var(--color-border);
  }

  .coming-soon-content {
    max-width: 600px;
    text-align: center;
  }

  .coming-soon-title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .coming-soon-divider {
    width: 80px;
    height: 4px;
    background: var(--color-border-light);
    margin: 0 auto var(--space-8);
  }

  .coming-soon-text {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .coming-soon-topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .topic {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: var(--border-medium) solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-tertiary);
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--space-8);
  }

  /* Post Card */
  .post-card {
    display: flex;
    flex-direction: column;
    border: var(--border-medium) solid var(--color-border);
    background: var(--color-bg-secondary);
    transition: all var(--transition-base);
  }

  .post-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-4px);
  }

  .post-image-link {
    display: block;
  }

  .post-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
    border: none;
  }

  .post-card:hover .post-image img {
    transform: scale(1.05);
  }

  .post-content {
    padding: var(--space-6);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-3);
  }

  .meta-separator {
    color: var(--color-border);
  }

  .post-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }

  .post-title a {
    color: var(--color-text-primary);
    transition: color var(--transition-base);
  }

  .post-title a:hover {
    color: var(--color-accent-primary);
  }

  .post-excerpt {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag {
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-tertiary);
    transition: all var(--transition-base);
  }

  .tag:hover {
    border-color: var(--color-border-light);
    color: var(--color-text-primary);
  }

  .read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    transition: color var(--transition-base);
    align-self: flex-start;
  }

  .read-more:hover {
    color: var(--color-accent-primary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .blog-page {
      padding: var(--space-8) 0;
    }

    .coming-soon {
      min-height: 300px;
      padding: var(--space-6);
    }

    .coming-soon-title {
      font-size: clamp(var(--text-3xl), 8vw, var(--text-4xl));
    }

    .coming-soon-text {
      font-size: var(--text-base);
    }

    .coming-soon-topics {
      gap: var(--space-2);
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .tag-filter {
      padding: var(--space-4);
    }

    .post-content {
      padding: var(--space-4);
    }
  }
</style>
