---
/**
 * Tag Filter Page
 * Shows all blog posts with a specific tag
 */

import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

// Generate static paths for all tags
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const allTags = [...new Set(posts.flatMap(post => post.data.tags))];

  return allTags.map(tag => ({
    params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const tagSlug = Astro.params.tag;

// Get all posts with this tag
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => {
    const postTagSlugs = post.data.tags.map(t => t.toLowerCase().replace(/\s+/g, '-'));
    return postTagSlugs.includes(tagSlug) && !post.data.draft;
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Format date helper
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};
---

<Layout
  title={`${tag} Posts - Torcheye Games Blog`}
  description={`Browse all blog posts tagged with "${tag}" from Torcheye Games.`}
>
  <div class="tag-page">
    <div class="container">
      <!-- Header -->
      <section class="tag-header">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/blog" class="breadcrumb-link">← Back to Blog</a>
        </nav>

        <h1 class="page-title">
          <span class="tag-label">Tag:</span> {tag}
        </h1>
        <p class="post-count">
          {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        </p>
      </section>

      <!-- Posts List -->
      <section class="posts-section">
        {posts.length === 0 ? (
          <div class="no-posts">
            <p>No posts found with this tag.</p>
            <a href="/blog" class="btn">Browse All Posts</a>
          </div>
        ) : (
          <div class="posts-grid">
            {posts.map(post => (
              <article class="post-card">
                {post.data.coverImage && (
                  <a href={`/blog/${post.id}`} class="post-image-link">
                    <div class="post-image">
                      <img
                        src={post.data.coverImage}
                        alt={`Cover for ${post.data.title}`}
                        loading="lazy"
                      />
                    </div>
                  </a>
                )}

                <div class="post-content">
                  <div class="post-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                    {post.data.author && (
                      <>
                        <span class="meta-separator">•</span>
                        <span class="post-author">{post.data.author}</span>
                      </>
                    )}
                  </div>

                  <h2 class="post-title">
                    <a href={`/blog/${post.id}`}>
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="post-excerpt">{post.data.excerpt}</p>

                  {post.data.tags.length > 0 && (
                    <div class="post-tags">
                      {post.data.tags.map(postTag => (
                        <a
                          href={`/blog/tags/${postTag.toLowerCase().replace(/\s+/g, '-')}`}
                          class:list={['tag', { active: postTag === tag }]}
                        >
                          {postTag}
                        </a>
                      ))}
                    </div>
                  )}

                  <a href={`/blog/${post.id}`} class="read-more">
                    Read More →
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</Layout>

<style>
  .tag-page {
    padding: var(--space-16) 0;
  }

  /* Header */
  .tag-header {
    margin-bottom: var(--space-12);
  }

  .breadcrumb {
    margin-bottom: var(--space-6);
  }

  .breadcrumb-link {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    transition: color var(--transition-base);
  }

  .breadcrumb-link:hover {
    color: var(--color-text-primary);
  }

  .page-title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    margin-bottom: var(--space-3);
  }

  .tag-label {
    font-size: var(--text-xl);
    color: var(--color-text-tertiary);
    font-weight: 400;
  }

  .post-count {
    font-size: var(--text-base);
    color: var(--color-text-tertiary);
  }

  /* No Posts */
  .no-posts {
    text-align: center;
    padding: var(--space-12);
    background: var(--color-bg-secondary);
    border: var(--border-medium) solid var(--color-border);
  }

  .no-posts p {
    font-size: var(--text-lg);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-6);
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--space-8);
  }

  /* Post Card */
  .post-card {
    display: flex;
    flex-direction: column;
    border: var(--border-medium) solid var(--color-border);
    background: var(--color-bg-secondary);
    transition: all var(--transition-base);
  }

  .post-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-4px);
  }

  .post-image-link {
    display: block;
  }

  .post-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
    border: none;
  }

  .post-card:hover .post-image img {
    transform: scale(1.05);
  }

  .post-content {
    padding: var(--space-6);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-3);
  }

  .meta-separator {
    color: var(--color-border);
  }

  .post-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }

  .post-title a {
    color: var(--color-text-primary);
    transition: color var(--transition-base);
  }

  .post-title a:hover {
    color: var(--color-accent-primary);
  }

  .post-excerpt {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag {
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-tertiary);
    transition: all var(--transition-base);
  }

  .tag:hover {
    border-color: var(--color-border-light);
    color: var(--color-text-primary);
  }

  .tag.active {
    border-color: var(--color-border-light);
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  .read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    transition: color var(--transition-base);
    align-self: flex-start;
  }

  .read-more:hover {
    color: var(--color-accent-primary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .tag-page {
      padding: var(--space-8) 0;
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .post-content {
      padding: var(--space-4);
    }
  }
</style>
