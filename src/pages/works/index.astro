---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { PROJECTS } from "@consts";
import { getCollection } from "astro:content";

const allProjects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = allProjects.find((project) => project.data.featured) ?? allProjects[0];
const rest = featured ? allProjects.filter((project) => project.id !== featured.id) : allProjects;
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="space-y-12" data-pagefind-ignore>
      <section class="animate space-y-3">
        <p class="text-sm uppercase tracking-[0.3em] text-neutral-500 dark:text-neutral-400">
          Works
        </p>
        <h1 class="text-4xl font-semibold text-black dark:text-white">Atmospheric experiences</h1>
        <p class="max-w-2xl text-base text-black/70 dark:text-white/70">
          Atmospheric experiences that explore light, shadow, and the spaces between. Every project experiments with
          contrast-driven mechanics, painterly visuals, and quiet storytelling.
        </p>
      </section>

      {featured && (
        <section class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
          <article class="animate space-y-4 rounded-2xl border border-black/15 bg-white/70 p-6 shadow-black/5 transition hover:-translate-y-1 dark:border-white/10 dark:bg-white/5">
            <span class="inline-flex rounded-full border border-black/15 px-3 py-1 text-xs uppercase tracking-[0.4em] text-black/70 dark:border-white/20 dark:text-white/60">
              Featured
            </span>
            <h2 class="text-3xl font-semibold text-black dark:text-white">{featured.data.title}</h2>
            <p class="text-base leading-relaxed text-black/70 dark:text-white/70">
              {featured.data.description}
            </p>
            {featured.data.tags?.length ? (
              <ul class="flex flex-wrap gap-2 text-xs uppercase tracking-[0.2em] text-black/60 dark:text-white/50">
                {featured.data.tags.map((tag) => (
                  <li class="rounded-sm border border-black/15 px-3 py-1 dark:border-white/20">{tag}</li>
                ))}
              </ul>
            ) : null}
            <div class="flex flex-wrap gap-3">
              {featured.data.steamURL && (
                <a
                  href={featured.data.steamURL}
                  class="rounded-sm border border-black/15 bg-black px-4 py-2 text-sm font-semibold text-white transition hover:opacity-80 dark:border-white/20"
                >
                  Wishlist on Steam
                </a>
              )}
              <Link href="/" underline={false}>
                View game page
              </Link>
            </div>
          </article>
          <figure class="animate overflow-hidden rounded-2xl border border-black/15 dark:border-white/10">
            <img
              src={featured.data.coverImage ?? "/cover-image.png"}
              alt={`${featured.data.title} cover`}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </figure>
        </section>
      )}

      {rest.length > 0 ? (
        <section class="space-y-4">
          <div class="animate flex items-center justify-between">
            <h3 class="text-2xl font-semibold text-black dark:text-white">More games</h3>
            <Link href="/works/archive">View archive</Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {rest.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <section class="animate rounded-xl border border-dashed border-black/15 p-6 text-sm leading-relaxed text-black/70 dark:border-white/20 dark:text-white/70">
          <p class="font-semibold text-black dark:text-white">More games coming soon</p>
          <p>
            We're expanding our portfolio with new experiments built around contrast, reflection, and tactile narratives.
          </p>
        </section>
      )}
    </div>
  </Container>
</Layout>
