---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";

const features = [
  "Complete game catalog with detailed information",
  "Filter by genre, platform, and tags",
  "Search functionality with Pagefind",
  "Direct links to wishlists and store pages",
];
---

<Layout title="Archive" description="Browse every Torcheye Games release and experiment.">
  <Container>
    <div class="space-y-10" data-pagefind-ignore>
      <section class="animate space-y-3">
        <p class="text-sm uppercase tracking-[0.3em] text-neutral-500 dark:text-neutral-400">
          Works
        </p>
        <h1 class="text-4xl font-semibold text-black dark:text-white">Game archive</h1>
        <p class="max-w-2xl text-base text-black/70 dark:text-white/70">
          A complete collection of our games — released, in-development, and experimental builds.
        </p>
      </section>

      <section class="animate">
        <Link href="/works">← Back to featured</Link>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <article class="animate space-y-4 rounded-2xl border border-black/15 bg-white/70 p-6 shadow-black/5 dark:border-white/10 dark:bg-white/5">
          <h2 class="text-2xl font-semibold text-black dark:text-white">Archive coming soon</h2>
          <p class="text-base leading-relaxed text-black/70 dark:text-white/70">
            We're building a permanent archive that gathers every project, prototype, and collaboration in one place.
          </p>
          <ul class="space-y-3 text-sm leading-relaxed text-black/70 dark:text-white/70">
            {features.map((feature) => (
              <li class="border-l border-black/15 pl-3 dark:border-white/20">{feature}</li>
            ))}
          </ul>
          <p class="text-sm text-black/60 dark:text-white/60">
            In the meantime, explore <Link href="/works">the featured showcase</Link> or follow along on the
            <Link href="/blog"> dev blog</Link>.
          </p>
        </article>
        <article class="animate space-y-4 rounded-2xl border border-dashed border-black/15 p-6 text-sm leading-relaxed text-black/70 dark:border-white/20 dark:text-white/70">
          <h3 class="text-xl font-semibold text-black dark:text-white">Future layout preview</h3>
          <div class="grid gap-4">
            <div class="rounded-xl border border-black/15 bg-white/70 p-4 dark:border-white/20 dark:bg-white/5">
              <p class="text-xs uppercase tracking-[0.3em] text-black/60 dark:text-white/50">01</p>
              <p class="font-semibold text-black dark:text-white">Chiaroscuro</p>
              <p>Puzzle • Platformer</p>
            </div>
            <div class="rounded-xl border border-black/15 bg-white/50 p-4 text-black/50 dark:border-white/20 dark:bg-white/5 dark:text-white/40">
              <p class="text-xs uppercase tracking-[0.3em]">02</p>
              <p>Coming Soon</p>
              <p>TBA</p>
            </div>
            <div class="rounded-xl border border-black/15 bg-white/30 p-4 text-black/40 dark:border-white/20 dark:bg-white/5 dark:text-white/30">
              <p class="text-xs uppercase tracking-[0.3em]">03</p>
              <p>Coming Soon</p>
              <p>TBA</p>
            </div>
          </div>
        </article>
      </section>
    </div>
  </Container>
</Layout>
