---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
---

<Layout title="Studio" description="Meet the small team behind Torcheye Games.">
  <Container>
    <div class="space-y-12" data-pagefind-ignore>
      <section class="animate space-y-4">
        <p class="text-sm uppercase tracking-[0.3em] text-neutral-500 dark:text-neutral-400">Studio</p>
        <h1 class="text-4xl font-semibold text-black dark:text-white">About Torcheye Games</h1>
        <p class="max-w-2xl text-base text-black/70 dark:text-white/70">
          Innovation at the foremost. Thought-provoking. Aesthetically groundbreaking. We build atmospheric interactive
          experiences by obsessing over light, shadow, and the emotions that live between them.
        </p>
        <ul class="grid gap-3 text-base text-black/80 dark:text-white/70 md:grid-cols-3">
          <li class="rounded-xl border border-black/15 px-4 py-3 text-center dark:border-white/20">Innovation at the foremost</li>
          <li class="rounded-xl border border-black/15 px-4 py-3 text-center dark:border-white/20">Thought-provoking</li>
          <li class="rounded-xl border border-black/15 px-4 py-3 text-center dark:border-white/20">Aesthetically groundbreaking</li>
        </ul>
      </section>

      <section class="space-y-6">
        <h2 class="animate text-2xl font-semibold text-black dark:text-white">The Team</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <article class="animate space-y-3 rounded-2xl border border-black/15 bg-white/70 p-6 dark:border-white/10 dark:bg-white/5">
            <figure class="overflow-hidden rounded-xl">
              <img src="/images/team/King.jpg" alt="Portrait of King Zhou" class="h-64 w-full object-cover" loading="lazy" />
            </figure>
            <div class="space-y-2">
              <h3 class="text-2xl font-semibold text-black dark:text-white">King Zhou</h3>
              <p class="text-sm uppercase tracking-[0.3em] text-black/60 dark:text-white/50">Founder & Developer</p>
              <p class="text-base leading-relaxed text-black/70 dark:text-white/70">
                Passionate, curious, and creative. Devoted to crafting innovative, beautiful, and accessible interactive
                experiences. When not coding, King can be found exploring euro board games, culinary experiments, and nature.
              </p>
            </div>
          </article>
          <article class="animate space-y-3 rounded-2xl border border-black/15 bg-white/70 p-6 dark:border-white/10 dark:bg-white/5">
            <figure class="overflow-hidden rounded-xl">
              <img src="/images/team/Timmie.jpg" alt="Portrait of Timmie" class="h-64 w-full object-cover" loading="lazy" />
            </figure>
            <div class="space-y-2">
              <h3 class="text-2xl font-semibold text-black dark:text-white">Timmie</h3>
              <p class="text-sm uppercase tracking-[0.3em] text-black/60 dark:text-white/50">Chief Morale Officer</p>
              <p class="text-base leading-relaxed text-black/70 dark:text-white/70">
                Professional keyboard warmer and bug finder. Specializes in QA by strolling across the keyboard at critical
                moments. Expert in nap optimization and providing emotional support during crunch time.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="animate text-2xl font-semibold text-black dark:text-white">Get in touch</h2>
        <p class="animate max-w-2xl text-base text-black/70 dark:text-white/70">
          We'd love to hear from you. For partnership ideas, feedback, or to simply say hi, reach out through the
          channels below.
        </p>
        <div class="animate flex flex-wrap gap-3">
          <a
            href="mailto:hello@torcheyegames.com"
            class="rounded-sm border border-black/15 px-4 py-2 text-sm font-semibold transition hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white"
          >
            Email us
          </a>
          <a
            href="https://twitter.com/torcheyegames"
            class="rounded-sm border border-black/15 px-4 py-2 text-sm font-semibold transition hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white"
            target="_blank"
            rel="noopener noreferrer"
          >
            Twitter
          </a>
          <a
            href="https://discord.gg/RHggGYAQjp"
            class="rounded-sm border border-black/15 px-4 py-2 text-sm font-semibold transition hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discord
          </a>
        </div>
      </section>
    </div>
  </Container>
</Layout>
