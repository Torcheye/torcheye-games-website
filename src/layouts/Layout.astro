---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";
import { getLocaleFromUrl } from "@i18n/utils";

type Props = {
  title: string;
  description: string;
  image?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
};

const { title, description, image, type, publishedTime, modifiedTime } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const langMap = { en: "en", zh: "zh-CN" };
---

<!doctype html>
<html lang={langMap[locale]}>
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
  </head>
  <body>
    <noscript>
      <style>
        .animate{
          opacity:1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <Header locale={locale} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <Pagefind />
    <script is:inline>
      let overlay;
      let overlayImage;
      let overlayCaption;
      let overlayInitialized = false;
      let previousScrollY = 0;

      const closeLightbox = () => {
        if (!overlay || !overlayImage) {
          return;
        }

        overlay.classList.remove("is-open");
        overlayImage.removeAttribute("src");
        document.body.classList.remove("lightbox-open");
        document.body.style.removeProperty("top");
        window.scrollTo({
          top: previousScrollY,
          behavior: "auto",
        });
      };

      const ensureOverlay = () => {
        if (overlayInitialized) {
          return;
        }

        overlay = document.createElement("div");
        overlay.className = "image-lightbox";
        overlay.setAttribute("role", "dialog");
        overlay.setAttribute("aria-modal", "true");
        overlay.setAttribute("aria-label", "Expanded image preview");

        const overlayFigure = document.createElement("figure");
        overlayFigure.className = "image-lightbox__figure";

        overlayImage = document.createElement("img");
        overlayImage.alt = "";

        overlayCaption = document.createElement("figcaption");

        overlayFigure.append(overlayImage, overlayCaption);
        overlay.append(overlayFigure);
        document.body.appendChild(overlay);

        overlay.addEventListener("click", (event) => {
          if (event.target === overlay) {
            closeLightbox();
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && overlay.classList.contains("is-open")) {
            closeLightbox();
          }
        });

        overlayInitialized = true;
      };

      const initImageLightbox = () => {
        const figures = document.querySelectorAll("article figure[data-lightbox]");
        if (!figures.length) {
          return;
        }

        ensureOverlay();

        figures.forEach((figure) => {
          const triggerImage = figure.querySelector("img");
          if (!triggerImage || triggerImage.dataset.lightboxBound === "true") {
            return;
          }

          triggerImage.dataset.lightboxBound = "true";
          triggerImage.addEventListener("click", () => {
            previousScrollY =
              window.scrollY ||
              document.documentElement.scrollTop ||
              0;
            document.body.style.top = `-${previousScrollY}px`;
            overlayImage.src =
              triggerImage.dataset.lightboxSrc ||
              triggerImage.currentSrc ||
              triggerImage.src;
            overlayImage.alt = triggerImage.alt || "";
            const caption = figure.querySelector("figcaption");
            overlayCaption.textContent = caption?.textContent?.trim() || "";
            overlay.classList.add("is-open");
            document.body.classList.add("lightbox-open");
          });
        });
      };

      const setupLightbox = () => {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initImageLightbox, { once: true });
        } else {
          initImageLightbox();
        }
      };

      setupLightbox();
      document.addEventListener("astro:page-load", initImageLightbox);
    </script>
  </body>
</html>
