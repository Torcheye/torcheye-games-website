---
import { languages, getAlternateLocaleUrl, type SupportedLanguage } from "@i18n/utils";

interface Props {
  locale: SupportedLanguage;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const alternateLocale: SupportedLanguage = locale === "en" ? "zh" : "en";

// Check if we're on a blog post page (not the blog index)
const isBlogPost = currentPath.includes('/blog/') && !currentPath.endsWith('/blog') && !currentPath.endsWith('/blog/');

let alternateUrl: string;
if (isBlogPost) {
  // Redirect to blog index in the alternate language
  alternateUrl = alternateLocale === "en" ? "/blog" : "/zh/blog";
} else {
  // Use normal alternate URL logic
  alternateUrl = getAlternateLocaleUrl(currentPath, alternateLocale);
}
---

<div class="language-switcher">
  <a
    href={alternateUrl}
    class="language-link"
    data-language-link
    aria-label={`Switch to ${languages[alternateLocale]}`}
    title={`Switch to ${languages[alternateLocale]}`}
  >
    <span class="current-lang" data-current-lang aria-hidden="true">{locale.toUpperCase()}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
      <path d="M2 12h20"></path>
    </svg>
  </a>
</div>

<script>
  import { getLocaleFromUrl, getAlternateLocaleUrl, languages, type SupportedLanguage } from "@i18n/utils";

  function updateLanguageSwitcher() {
    const link = document.querySelector<HTMLAnchorElement>('[data-language-link]');
    const currentLangSpan = document.querySelector<HTMLSpanElement>('[data-current-lang]');

    if (!link || !currentLangSpan) return;

    const currentPath = window.location.pathname;
    const currentLocale = getLocaleFromUrl(currentPath);
    const alternateLocale: SupportedLanguage = currentLocale === "en" ? "zh" : "en";

    // Check if we're on a blog post page (not the blog index)
    const isBlogPost = currentPath.includes('/blog/') && !currentPath.endsWith('/blog') && !currentPath.endsWith('/blog/');

    let alternateUrl: string;
    if (isBlogPost) {
      // Redirect to blog index in the alternate language
      alternateUrl = alternateLocale === "en" ? "/blog" : "/zh/blog";
    } else {
      // Use normal alternate URL logic
      alternateUrl = getAlternateLocaleUrl(currentPath, alternateLocale);
    }

    // Update the link and display
    link.href = alternateUrl;
    link.setAttribute('aria-label', `Switch to ${languages[alternateLocale]}`);
    link.setAttribute('title', `Switch to ${languages[alternateLocale]}`);
    currentLangSpan.textContent = currentLocale.toUpperCase();
  }

  // Update on initial load
  updateLanguageSwitcher();

  // Update after Astro view transitions
  document.addEventListener('astro:page-load', updateLanguageSwitcher);
</script>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
  }

  .language-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius);
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .language-link:hover {
    background-color: var(--bg-secondary);
    border-color: var(--border-color);
  }

  .current-lang {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .language-link svg {
    width: 1rem;
    height: 1rem;
    opacity: 0.7;
  }
</style>
