---
interface Feature {
	title: string;
	description: string;
	coverImage: string;
	gifUrl: string;
	align: 'left' | 'right';
}

interface Props {
	features?: Feature[];
	showHeading?: boolean;
}

const {
	features = [
		{
			title: "Embrace Shadows",
			description: "Explore vast, detailed environments crafted with stunning visuals and atmospheric depth.",
			coverImage: "/cover-image.png",
			gifUrl: "/cover-image.png",
			align: "left" as const,
		},
		{
			title: "Manipulate Lights",
			description: "Engage in fast-paced, strategic battles with responsive controls and deep combat systems.",
			coverImage: "/cover-image.png",
			gifUrl: "/cover-image.png",
			align: "right" as const,
		},
		{
			title: "Explore Dreams",
			description: "Experience compelling narratives with memorable characters and choices that shape your journey.",
			coverImage: "/cover-image.png",
			gifUrl: "/cover-image.png",
			align: "left" as const,
		},
	],
	showHeading = false
} = Astro.props;
---

<section class="features-section">
	<div class="features-container">
		{showHeading && <h2 class="features-heading">Key Features</h2>}

		<div class="features-list">
			{features.map((feature, index) => (
				<div
					class={`feature-item ${feature.align === 'left' ? 'align-left' : 'align-right'}`}
					data-index={index}
				>
					<!-- Text Overlay -->
					<div class={`feature-text ${feature.align === 'left' ? 'text-left' : 'text-right'}`}>
						<h3 class="feature-title">{feature.title}</h3>
						<p class="feature-description">{feature.description}</p>
					</div>

					<!-- Image Container -->
					<div class="feature-image-container">
						<img
							src={feature.coverImage}
							alt={feature.title}
							class="feature-image feature-cover"
							loading="lazy"
						/>
						<img
							src={feature.gifUrl}
							alt={`${feature.title} animation`}
							class="feature-image feature-gif"
							loading="lazy"
						/>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.features-section {
		padding: 4rem 2rem;
		background-color: #1e1c32;
		text-align: center;
	}

	.features-container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.features-heading {
		font-family: 'IM Fell English', serif;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		color: var(--color-text-primary, #c6baac);
		margin: 0 0 4rem 0;
		text-align: center;
	}

	.features-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* Feature Item */
	.feature-item {
		position: relative;
		width: 100%;
		height: 300px;
		overflow: hidden;
		background-color: #1e1c32;
		transition: height 0.3s ease;
	}

	.feature-item:hover {
		height: 600px;
	}

	/* Text Overlay */
	.feature-text {
		position: absolute;
		z-index: 10;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		width: 400px;
		height: 100%;
		transition: opacity 0.3s ease;
		opacity: 1;
		pointer-events: none;
	}

	.feature-item:hover .feature-text {
		opacity: 0;
	}

	.text-left {
		left: 0;
		align-items: flex-start;
		text-align: left;
		background: linear-gradient(to right, #1e1c32 0%, #1e1c32 60%, transparent 100%);
	}

	.text-right {
		right: 0;
		align-items: flex-end;
		text-align: right;
		background: linear-gradient(to left, #1e1c32 0%, #1e1c32 60%, transparent 100%);
	}

	.feature-title {
		font-family: 'IM Fell English', serif;
		font-size: clamp(2rem, 4vw, 2.5rem);
		color: var(--color-text-primary, #e4e4e4);
		margin: 0 0 1rem 0;
	}

	.feature-description {
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--color-text-secondary, #b4b4b4);
		margin: 0;
		max-width: 350px;
	}

	/* Image Container */
	.feature-image-container {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.feature-image {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.5s ease, transform 0.5s ease;
	}

	.feature-cover {
		opacity: 1;
		z-index: 1;
	}

	.feature-gif {
		opacity: 0;
		z-index: 2;
	}

	.feature-item:hover .feature-cover {
		opacity: 0;
	}

	.feature-item:hover .feature-gif {
		opacity: 1;
		transform: scale(1.05);
	}

	/* Alignment specific adjustments */
	.align-left .feature-image {
		transform-origin: right center;
	}

	.align-right .feature-image {
		transform-origin: left center;
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.features-section {
			padding: 3rem 1rem;
		}

		.features-heading {
			margin-bottom: 2rem;
		}

		.feature-item {
			height: 250px;
		}

		.feature-item:hover {
			height: 400px;
		}

		.feature-text {
			width: 100%;
			padding: 1.5rem;
			background: linear-gradient(to bottom, #1e1c32 0%, #1e1c32 60%, transparent 100%) !important;
			align-items: center !important;
			text-align: center !important;
		}

		.text-left,
		.text-right {
			left: 0;
			right: 0;
		}

		.feature-title {
			font-size: 1.75rem;
		}

		.feature-description {
			font-size: 1rem;
			max-width: 100%;
		}
	}

	@media (max-width: 480px) {
		.feature-item {
			height: 200px;
		}

		.feature-item:hover {
			height: 300px;
		}

		.feature-text {
			padding: 1rem;
		}

		.feature-title {
			font-size: 1.5rem;
			margin-bottom: 0.5rem;
		}

		.feature-description {
			font-size: 0.875rem;
		}
	}
</style>
