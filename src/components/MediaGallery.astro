---
interface Image {
	id: number;
	url: string;
	alt?: string;
}

interface Props {
	images?: Image[];
	autoPlayInterval?: number;
	showHeading?: boolean;
}

const {
	images = [
		{ id: 1, url: "/cover-image.png", alt: "Screenshot 1" },
		{ id: 2, url: "/cover-image.png", alt: "Screenshot 2" },
		{ id: 3, url: "/cover-image.png", alt: "Screenshot 3" },
		{ id: 4, url: "/cover-image.png", alt: "Screenshot 4" },
		{ id: 5, url: "/cover-image.png", alt: "Screenshot 5" },
		{ id: 6, url: "/cover-image.png", alt: "Screenshot 6" },
	],
	autoPlayInterval = 3000,
	showHeading = false
} = Astro.props;
---

<section class="gallery-section">
	{showHeading && <h2 class="gallery-heading">Screenshots</h2>}

	<div class="gallery-container">
		<!-- Main Display -->
		<div class="main-display" id="mainDisplay">
			<img
				src={images[0].url}
				alt={images[0].alt || "Gallery image"}
				class="main-image"
				id="mainImage"
				loading="eager"
			/>

			<!-- Navigation Arrows -->
			<div class="nav-arrows" id="navArrows">
				<button
					class="nav-button nav-prev"
					id="prevButton"
					aria-label="Previous image"
				>
					<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
				</button>
				<button
					class="nav-button nav-next"
					id="nextButton"
					aria-label="Next image"
				>
					<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</button>
			</div>
		</div>

		<!-- Thumbnail Strip -->
		<div class="thumbnail-section">
			<div class="thumbnail-wrapper">
				<!-- Scroll Left Button -->
				<button
					class="thumbnail-scroll-button scroll-left"
					id="scrollLeftButton"
					aria-label="Scroll thumbnails left"
				>
					<svg class="scroll-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
				</button>

				<!-- Thumbnail Container -->
				<div class="thumbnail-container" id="thumbnailContainer">
					{images.map((image, index) => (
						<button
							class={`thumbnail ${index === 0 ? 'active' : ''}`}
							data-index={index}
							aria-label={`View image ${index + 1}`}
						>
							<img
								src={image.url}
								alt={image.alt || `Thumbnail ${index + 1}`}
								loading="lazy"
							/>
						</button>
					))}
				</div>

				<!-- Scroll Right Button -->
				<button
					class="thumbnail-scroll-button scroll-right"
					id="scrollRightButton"
					aria-label="Scroll thumbnails right"
				>
					<svg class="scroll-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>

<style>
	.gallery-section {
		width: 100%;
		min-height: 100vh;
		background-color: var(--color-bg-primary, #1e1c32);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 4rem 0;
	}

	.gallery-heading {
		font-family: 'IM Fell English', serif;
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		color: var(--color-text-primary, #c6baac);
		text-align: center;
		margin: 0 0 3rem 0;
	}

	.gallery-container {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
	}

	/* Main Display */
	.main-display {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
		overflow: hidden;
	}

	.main-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Navigation Arrows */
	.nav-arrows {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 2rem;
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}

	.main-display:hover .nav-arrows {
		opacity: 1;
		pointer-events: auto;
	}

	.nav-button {
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.8);
		cursor: pointer;
		padding: 0.5rem;
		transition: color 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.nav-button:hover {
		color: rgba(255, 255, 255, 1);
	}

	.nav-icon {
		width: 3rem;
		height: 3rem;
	}

	/* Thumbnail Section */
	.thumbnail-section {
		width: 100%;
		background: var(--color-bg-primary, #1e1c32);
		padding: 1.5rem 0;
	}

	.thumbnail-wrapper {
		position: relative;
		max-width: 1400px;
		margin: 0 auto;
	}

	.thumbnail-container {
		display: flex;
		gap: 0.5rem;
		padding: 0 1rem;
		overflow-x: auto;
		scroll-behavior: smooth;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.thumbnail-container::-webkit-scrollbar {
		display: none;
	}

	/* Thumbnails */
	.thumbnail {
		position: relative;
		flex-shrink: 0;
		width: 160px;
		height: 112px;
		overflow: hidden;
		border: none;
		background: none;
		padding: 0;
		cursor: pointer;
		opacity: 0.5;
		transition: all 0.3s ease;
	}

	.thumbnail:hover {
		opacity: 0.8;
	}

	.thumbnail.active {
		opacity: 1;
		transform: scale(1.05);
	}

	.thumbnail img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Thumbnail Scroll Buttons */
	.thumbnail-scroll-button {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.6);
		cursor: pointer;
		padding: 0.5rem;
		z-index: 10;
		opacity: 0;
		transition: all 0.3s ease;
		pointer-events: none;
	}

	.thumbnail-wrapper:hover .thumbnail-scroll-button {
		opacity: 1;
		pointer-events: auto;
	}

	.thumbnail-scroll-button:hover {
		color: rgba(255, 255, 255, 1);
	}

	.scroll-left {
		left: 0.5rem;
	}

	.scroll-right {
		right: 0.5rem;
	}

	.scroll-icon {
		width: 2rem;
		height: 2rem;
	}

	/* Responsive */
	@media (max-width: 1024px) {
		.gallery-section {
			padding: 3rem 0;
		}

		.nav-icon {
			width: 2.5rem;
			height: 2.5rem;
		}

		.thumbnail {
			width: 140px;
			height: 98px;
		}
	}

	@media (max-width: 768px) {
		.gallery-section {
			padding: 2rem 0;
		}

		.gallery-heading {
			margin-bottom: 2rem;
		}

		.nav-arrows {
			padding: 0 1rem;
		}

		.nav-icon {
			width: 2rem;
			height: 2rem;
		}

		.thumbnail {
			width: 120px;
			height: 84px;
		}

		.thumbnail-scroll-button {
			opacity: 1;
			pointer-events: auto;
		}
	}

	@media (max-width: 480px) {
		.thumbnail {
			width: 100px;
			height: 70px;
		}

		.scroll-icon {
			width: 1.5rem;
			height: 1.5rem;
		}
	}
</style>

<script define:vars={{ images, autoPlayInterval }}>
	let currentIndex = 0;
	let autoPlayTimer = null;

	const mainImage = document.getElementById('mainImage');
	const thumbnailContainer = document.getElementById('thumbnailContainer');
	const thumbnails = document.querySelectorAll('.thumbnail');
	const prevButton = document.getElementById('prevButton');
	const nextButton = document.getElementById('nextButton');
	const scrollLeftButton = document.getElementById('scrollLeftButton');
	const scrollRightButton = document.getElementById('scrollRightButton');

	// Update main image and active thumbnail
	function updateGallery(index) {
		currentIndex = index;

		// Update main image
		if (mainImage) {
			mainImage.src = images[currentIndex].url;
			mainImage.alt = images[currentIndex].alt || `Gallery image ${currentIndex + 1}`;
		}

		// Update active thumbnail
		thumbnails.forEach((thumb, i) => {
			if (i === currentIndex) {
				thumb.classList.add('active');
			} else {
				thumb.classList.remove('active');
			}
		});

		// Scroll thumbnail into view
		if (thumbnailContainer && thumbnails[currentIndex]) {
			const thumbnail = thumbnails[currentIndex];
			const thumbnailWidth = 160 + 8; // width + gap
			const scrollPosition = currentIndex * thumbnailWidth - thumbnailContainer.clientWidth / 2 + thumbnailWidth / 2;

			thumbnailContainer.scrollTo({
				left: scrollPosition,
				behavior: 'smooth'
			});
		}

		// Reset autoplay timer
		resetAutoPlay();
	}

	// Navigation functions
	function goToPrevious() {
		const newIndex = (currentIndex - 1 + images.length) % images.length;
		updateGallery(newIndex);
	}

	function goToNext() {
		const newIndex = (currentIndex + 1) % images.length;
		updateGallery(newIndex);
	}

	function goToImage(index) {
		updateGallery(index);
	}

	// Thumbnail scroll functions
	function scrollThumbnails(direction) {
		if (thumbnailContainer) {
			const scrollAmount = 400;
			thumbnailContainer.scrollBy({
				left: direction === 'left' ? -scrollAmount : scrollAmount,
				behavior: 'smooth'
			});
		}
	}

	// Auto-play functionality
	function startAutoPlay() {
		if (autoPlayInterval > 0) {
			autoPlayTimer = setInterval(() => {
				goToNext();
			}, autoPlayInterval);
		}
	}

	function stopAutoPlay() {
		if (autoPlayTimer) {
			clearInterval(autoPlayTimer);
			autoPlayTimer = null;
		}
	}

	function resetAutoPlay() {
		stopAutoPlay();
		startAutoPlay();
	}

	// Event listeners
	if (prevButton) {
		prevButton.addEventListener('click', goToPrevious);
	}

	if (nextButton) {
		nextButton.addEventListener('click', goToNext);
	}

	if (scrollLeftButton) {
		scrollLeftButton.addEventListener('click', () => scrollThumbnails('left'));
	}

	if (scrollRightButton) {
		scrollRightButton.addEventListener('click', () => scrollThumbnails('right'));
	}

	thumbnails.forEach((thumbnail, index) => {
		thumbnail.addEventListener('click', () => goToImage(index));
	});

	// Pause autoplay on hover
	const mainDisplay = document.getElementById('mainDisplay');
	if (mainDisplay) {
		mainDisplay.addEventListener('mouseenter', stopAutoPlay);
		mainDisplay.addEventListener('mouseleave', startAutoPlay);
	}

	// Keyboard navigation
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') {
			goToPrevious();
		} else if (e.key === 'ArrowRight') {
			goToNext();
		}
	});

	// Start autoplay on load
	startAutoPlay();
</script>
