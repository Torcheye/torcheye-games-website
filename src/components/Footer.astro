---
/**
 * Footer Component
 * Global footer with social links, quick navigation, and copyright
 */

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'Twitter',
    url: 'https://twitter.com/torcheyegames',
    icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
    ariaLabel: 'Follow us on Twitter'
  },
  {
    name: 'Discord',
    url: 'https://discord.gg/RHggGYAQjp',
    icon: `<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>`,
    ariaLabel: 'Join our Discord server'
  },
  {
    name: 'Email',
    url: 'mailto:hello@torcheyegames.com',
    icon: `<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>`,
    ariaLabel: 'Send us an email'
  }
];

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/studio', label: 'Studio' },
  { href: '/works', label: 'Works' },
  { href: '/blog', label: 'Blog' }
];
---

<footer class="site-footer">
  <div class="footer-container">
    <!-- Top Section: Logo and Social Links -->
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="footer-logo-text">Torcheye Games</span>
        </a>
        <p class="footer-tagline">Crafting immersive indie experiences</p>
      </div>

      <div class="social-links">
        {socialLinks.map(link => (
          <a
            href={link.url}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.ariaLabel}
          >
            <svg
              class="social-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <Fragment set:html={link.icon} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Middle Section: Quick Links -->
    <nav class="footer-nav" aria-label="Footer navigation">
      <h3 class="footer-nav-title">Quick Links</h3>
      <ul class="footer-nav-list">
        {quickLinks.map(link => (
          <li>
            <a href={link.href} class="footer-nav-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Bottom Section: Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} Torcheye Games. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-secondary);
    border-top: var(--border-thick) solid var(--color-border);
    margin-top: auto;
    padding: var(--space-12) 0 var(--space-6);
  }

  .footer-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* Top Section */
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: var(--border-medium) solid var(--color-border);
    margin-bottom: var(--space-8);
  }

  .footer-brand {
    flex: 1;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  .footer-logo-text {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    transition: color var(--transition-base);
  }

  .footer-logo:hover .footer-logo-text {
    color: var(--color-accent-primary);
  }

  .footer-tagline {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    margin: 0;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: var(--border-medium) solid var(--color-border);
    background: var(--color-bg-primary);
    color: var(--color-text-tertiary);
    transition: all var(--transition-base);
  }

  .social-link:hover {
    background: var(--color-bg-tertiary);
    border-color: var(--color-border-light);
    color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  .social-icon {
    width: 20px;
    height: 20px;
  }

  /* Middle Section - Navigation */
  .footer-nav {
    margin-bottom: var(--space-8);
  }

  .footer-nav-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer-nav-link {
    font-size: var(--text-base);
    color: var(--color-text-tertiary);
    transition: color var(--transition-base);
  }

  .footer-nav-link:hover {
    color: var(--color-text-primary);
  }

  /* Bottom Section - Copyright */
  .footer-bottom {
    padding-top: var(--space-6);
    border-top: var(--border-thin) solid var(--color-border-dark);
    text-align: center;
  }

  .copyright {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .site-footer {
      padding: var(--space-8) 0 var(--space-4);
    }

    .footer-top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-6);
      padding-bottom: var(--space-6);
      margin-bottom: var(--space-6);
    }

    .footer-brand {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .footer-logo-text {
      font-size: var(--text-xl);
    }

    .social-links {
      justify-content: center;
    }

    .footer-nav {
      text-align: center;
      margin-bottom: var(--space-6);
    }

    .footer-nav-list {
      justify-content: center;
      gap: var(--space-4);
    }

    .footer-nav-link {
      font-size: var(--text-sm);
    }

    .social-link {
      width: 40px;
      height: 40px;
    }

    .social-icon {
      width: 18px;
      height: 18px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .social-links {
      align-self: flex-start;
    }
  }
</style>
