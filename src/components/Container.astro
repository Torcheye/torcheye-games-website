---
import { cn } from "@lib/utils";

type Props = {
  variant?: "default" | "full" | "blog";
  class?: string;
};

const { variant = "default", class: className, ...rest } = Astro.props as Props;

const sharedWidth = "mx-auto w-full max-w-[min(75vw,1200px)]";

const variantClasses: Record<Required<Props>["variant"], string> = {
  default: sharedWidth,
  full: sharedWidth,
  blog: sharedWidth,
};
---

<div
  class={cn(
    "w-full px-3 sm:px-6 lg:px-8",
    variantClasses[variant],
    className,
  )}
  {...rest}
>
  <slot />
</div>
