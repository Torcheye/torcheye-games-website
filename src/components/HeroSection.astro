---
interface Props {
	videoId?: string;
	title?: string;
	tagline?: string;
	releaseYear?: string;
	steamUrl?: string;
}

const {
	videoId = "d-wI4MjySb8",
	title = "Chiaroscuro",
	tagline = "A Game of Light and Shadow",
	releaseYear = "2026",
	steamUrl = "https://store.steampowered.com/app/2831270"
} = Astro.props;
---

<section class="hero-section">
	<div class="hero-container">
		<!-- Video Embed -->
		<div class="video-wrapper">
			{videoId ? (
				<iframe
					src={`https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`}
					title={`${title} Trailer`}
					frameborder="0"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
					loading="eager"
				></iframe>
			) : (
				<div class="video-placeholder">
					<p>[Video Embed Placeholder - Insert YouTube/Vimeo iframe here]</p>
				</div>
			)}
		</div>

		<!-- Title and CTA -->
		<div class="hero-content">
			<h1 class="hero-title" id="heroTitle">{title}</h1>

			<p class="hero-tagline">{tagline}</p>

			<a href={steamUrl} class="steam-button" target="_blank" rel="noopener noreferrer">
				<svg
					class="steam-icon"
					viewBox="0 0 24 24"
					fill="currentColor"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5l7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z" />
				</svg>
				Wishlist on Steam
			</a>

			<p class="release-date">Coming {releaseYear}</p>
		</div>
	</div>
</section>

<style>
	.hero-section {
		width: 100%;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 3rem 1rem;
		background-color: var(--color-bg-primary, #1e1c32);
		opacity: 0;
		animation: fadeIn 1s ease-out forwards;
	}

	.hero-container {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	/* Video Section */
	.video-wrapper {
		position: relative;
		width: 100%;
		padding-bottom: 56.25%; /* 16:9 aspect ratio */
		border: 2px solid var(--color-border-light, #c6baac);
		overflow: hidden;
		background: #000;
	}

	.video-wrapper iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.video-placeholder {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.2);
	}

	.video-placeholder p {
		color: var(--color-text-tertiary, #8a7f70);
		font-size: 1rem;
		text-align: center;
		padding: 1rem;
	}

	/* Hero Content */
	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 2rem;
	}

	.hero-title {
		font-family: 'IM Fell English', serif;
		font-size: clamp(3rem, 8vw, 6rem);
		font-weight: 700;
		color: var(--color-text-primary, #c6baac);
		margin: 0;
		letter-spacing: -0.02em;
		transition: filter 0.15s ease-out, text-shadow 0.15s ease-out;
		cursor: default;
	}

	.hero-tagline {
		font-family: 'IM Fell English', serif;
		font-size: clamp(1.25rem, 3vw, 2rem);
		color: var(--color-text-primary, #c6baac);
		margin: 0;
		letter-spacing: 0.05em;
	}

	/* Steam Button */
	.steam-button {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1.5rem 2rem;
		background: linear-gradient(135deg, #1b2838 0%, #2a475e 100%);
		color: var(--color-text-primary, #c6baac);
		border: 2px solid var(--color-border-light, #c6baac);
		border-radius: 0;
		font-size: 1.125rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.3s ease;
		cursor: pointer;
	}

	.steam-button:hover {
		background: linear-gradient(135deg, #2a475e 0%, #1b2838 100%);
		transform: scale(1.05);
	}

	.steam-icon {
		width: 1.5rem;
		height: 1.5rem;
	}

	.release-date {
		font-size: 1.25rem;
		font-weight: 500;
		color: var(--color-text-tertiary, #8a7f70);
		letter-spacing: 0.1em;
		margin: 0;
	}

	/* Animations */
	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero-section {
			padding: 2rem 1rem;
		}

		.hero-container {
			gap: 2rem;
		}

		.hero-content {
			gap: 1.5rem;
		}

		.steam-button {
			padding: 1rem 1.5rem;
			font-size: 1rem;
		}

		.steam-icon {
			width: 1.25rem;
			height: 1.25rem;
		}

		.video-placeholder p {
			font-size: 0.875rem;
		}
	}
</style>

<script>
	// Interactive light effect on title (inspired by Chiaroscuro theme)
	const titleElement = document.getElementById('heroTitle');

	if (titleElement) {
		let mouseX = 0;
		let mouseY = 0;

		const handleMouseMove = (e: MouseEvent) => {
			mouseX = e.clientX;
			mouseY = e.clientY;
			updateTitleEffect();
		};

		const updateTitleEffect = () => {
			const rect = titleElement.getBoundingClientRect();
			const centerX = rect.left + rect.width / 2;
			const centerY = rect.top + rect.height / 2;

			const deltaX = centerX - mouseX;
			const deltaY = centerY - mouseY;
			const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);

			const maxDistance = 800;
			const intensity = Math.max(0, Math.min(1, 1 - distance / maxDistance));

			const shadowDistance = 15 * intensity;
			const shadowX = (deltaX / distance) * shadowDistance || 0;
			const shadowY = (deltaY / distance) * shadowDistance || 0;

			const brightnessBoost = 1 + intensity * 0.5;

			titleElement.style.filter = `brightness(${brightnessBoost})`;
			titleElement.style.textShadow = `
				${shadowX}px ${shadowY}px ${10 + intensity * 20}px rgba(0, 0, 0, ${0.8 * intensity}),
				${shadowX * 1.5}px ${shadowY * 1.5}px ${20 + intensity * 30}px rgba(0, 0, 0, ${0.6 * intensity}),
				${shadowX * 2}px ${shadowY * 2}px ${30 + intensity * 40}px rgba(0, 0, 0, ${0.4 * intensity}),
				0 0 ${40 * intensity}px rgba(255, 223, 186, ${0.3 * intensity}),
				0 0 ${60 * intensity}px rgba(255, 255, 255, ${0.2 * intensity})
			`;
		};

		window.addEventListener('mousemove', handleMouseMove);
	}
</script>
